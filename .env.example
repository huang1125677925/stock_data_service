# Flask配置
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# 安全密钥
SECRET_KEY=your-secret-key-here

# 股票数据API配置
STOCK_API_KEY=your-stock-api-key
STOCK_API_BASE_URL=https://api.example.com

# 数据库配置
DATABASE_URL=sqlite:///stock_data.db

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0

# 缓存配置
CACHE_TYPE=simple
CACHE_TIMEOUT=300

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API限流
API_RATE_LIMIT=100/hour

# AI 模型（默认 DeepSeek；千问/豆包通过 AI_MODEL_PROVIDER 切换）
# AI_MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_NAME=deepseek-v4-flash
# DEEPSEEK_THINKING_TYPE=enabled
# DEEPSEEK_REASONING_EFFORT=high
# Qwen2API（可选）: AI_MODEL_PROVIDER=qwen2api
# QWEN2API_BASE_URL=https://qwen2api-n.smanx.xx.kg/v1
# QWEN2API_MODEL_NAME=qwen3.5-plus
# QWEN2API_API_KEY=
# 仅千问 qwen2api 生效：不支持原生 tool 时可开 JSON 协议；deepseek/doubao_seed 忽略此项
# AI_CHAT_TOOL_MODE=json_protocol

# 数据更新频率（秒）
DATA_UPDATE_INTERVAL=60

# 股票数据获取配置
STOCK_DATA_TIMEOUT=120
STOCK_DATA_RETRIES=3
STOCK_DATA_RETRY_DELAY=2

# 缓存配置
CACHE_MAX_AGE_MINUTES=360
CACHE_CLEANUP_HOURS=24
